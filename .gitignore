/.claude/*
!/.claude/skills

# --- OS Specific ---
.DS_Store
.DS_Store?
._*

# --- Azk (Ambler Zettelkasten) ---
# Binary SQLite file: not diffable/mergeable, so it's local-only per workstation.
.azk/
