# --- Rust ---
/target
**/*.rs.bk
*.pdb

# --- Environment and Secrets ---
.env
.env.*
.local

# --- IDE ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.idea/

